# Managed base config. Machine-local tools go in ~/.config/mise/config.toml
# (unmanaged — mise merges it with this file).
[settings]
idiomatic_version_file_enable_tools = ["ruby", "node", "yarn", "bun"]

[settings.ruby]
compile = false

[settings.npm]
shell_out = true

[tools]
fzf = "latest"
zoxide = "latest"
starship = "latest"
jq = "latest"      # required by the Claude Code statusline script
{{- if not .container }}
{{- if ne .chezmoi.os "darwin" }}
eza = "latest"
{{- else }}
# eza is deliberately absent on macOS. Upstream ships no darwin release asset (v0.23.5 has
# 16, zero apple), and mise has NO brew backend — `brew:eza` is not valid in any mise
# version, so it fails `mise install` outright and aborts the entire apply. macOS installs
# eza from homebrew-core in run_once_after_install-system-packages.sh, next to tmux/vim.
{{- end }}
bat = "latest"
fd = "latest"
ripgrep = "latest"
node = "22"
helix = "latest"
bottom = "latest"    # `btm` — lighter, narrow-friendly; used by the cmux dock Host panel
zig = "0.15.2"       # cmux builds GhosttyKit.xcframework; ghostty pins minimum_zig_version
herdr = "0.8.2"      # agent multiplexer; pinned because it is pre-1.0 and ships weekly
{{- if eq .chezmoi.os "linux" }}
"npm:@endevco/aube" = { version = "latest", npm_args = "--ignore-scripts=false" }   # aube — our Node package manager (jdx, same author as mise); its preinstall fetches the arch-specific binary
"github:aristocratos/btop" = "latest"   # btop via github backend (aqua asset-match is broken, ubi deprecated); Linux release binaries only
{{- end }}
{{- end }}
