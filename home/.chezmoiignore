# Per-machine escape hatch — sourced by .zshrc if present, never managed by chezmoi
.config/zsh/local.zsh

# Work-specific tooling kept local (not in this public repo); existing copies left intact.
.config/zsh/functions/rails-console

# use-spark talks to the Spark Desktop app over IPC — pointless without a Mac GUI
{{ if or (ne .chezmoi.os "darwin") .headless }}
.claude/skills/use-spark
{{ end }}

# launchd is macOS-only
{{ if ne .chezmoi.os "darwin" }}
Library
Library/**
{{ end }}

# systemd user units are Linux-only; agent accounts schedule their own work
{{ if or (ne .chezmoi.os "linux") .agent .container }}
.config/systemd
.config/systemd/**
{{ end }}

# Agent-owned accounts (e.g. Norm): ~/.claude is the agent's identity and brain.
# Nothing under it is ever managed — no statusline, no settings merge, no CLAUDE.md.
{{ if .agent }}
.claude
.claude/**
{{ end }}

# Agent-only credential shims. `gh` and `git` here SHADOW the real binaries on
# $PATH: gh injects a per-org fine-grained PAT, git refuses force-push and
# branch-delete. On a machine with no ~/.config/github-pats that would break
# github.com authentication outright, so they must never land on a non-agent
# host. git-credential-github-org is inert without them but is gated the same
# way for coherence.
{{ if not .agent }}
.local/bin/gh
.local/bin/git
.local/bin/git-credential-github-org
{{ end }}

# cmux is a macOS app; its dock.json (with ssh -t commands run FROM the Mac) only
# applies there. Ignore on non-Mac so agent/Linux hosts don't get a useless copy.
{{ if ne .chezmoi.os "darwin" }}
.config/cmux
.config/cmux/**
{{ end }}

# AeroSpace is a macOS tiling WM — useless without a GUI, so gate it the same way
# as use-spark. install-aerospace.sh carries the matching guard.
{{ if or (ne .chezmoi.os "darwin") .headless }}
.aerospace.toml
{{ end }}
