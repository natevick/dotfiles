# Per-machine escape hatch — sourced by .zshrc if present, never managed by chezmoi
.config/zsh/local.zsh

# Work-specific tooling kept local (not in this public repo); existing copies left intact.
.config/zsh/functions/rails-console

# use-spark talks to the Spark Desktop app over IPC — pointless without a Mac GUI
{{ if or (ne .chezmoi.os "darwin") .headless }}
.claude/skills/use-spark
{{ end }}

# Agent-owned accounts (e.g. Norm): ~/.claude is the agent's identity and brain.
# Nothing under it is ever managed — no statusline, no settings merge, no CLAUDE.md.
{{ if .agent }}
.claude
.claude/**
{{ end }}
