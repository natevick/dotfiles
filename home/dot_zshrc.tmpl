# ~/.zshrc — managed by chezmoi. Edit source: `chezmoi edit ~/.zshrc`

# ---- PATH ----
export PATH="$HOME/.local/bin:$PATH"
{{- if eq .chezmoi.os "darwin" }}
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
{{- end }}

# ---- History ----
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE INC_APPEND_HISTORY EXTENDED_HISTORY
setopt AUTO_CD INTERACTIVE_COMMENTS

# ---- Editor ----
export EDITOR=vim

# ---- Autoloaded functions ----
if [[ -d "$HOME/.config/zsh/functions" ]]; then
  fpath=("$HOME/.config/zsh/functions" $fpath)
  _zfns=("$HOME"/.config/zsh/functions/*(N:t))
  (( ${#_zfns} )) && autoload -Uz "${_zfns[@]}"
  unset _zfns
fi

# ---- cached tool init (avoid a subprocess fork on every startup) ----
# Caches an init/activation script; regenerates only when the tool's binary changes.
# Note: -nt does NOT detect a tool DOWNGRADE (older mtime) — `rm -rf ~/.cache/zsh` to force a rebuild.
# NOTE: do NOT `emulate -L zsh` here — it sets LOCAL_OPTIONS, which would revert `setopt`
# performed by the sourced init scripts (e.g. starship's `prompt_subst`) when this returns.
_eval_cached() {
  local name=$1; shift
  local bin=$1 binpath
  binpath=$(command -v "$bin") || return 0
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/${name}.zsh"
  if [[ ! -f "$cache" || "$binpath" -nt "$cache" ]]; then
    mkdir -p "${cache:h}"
    if "$@" >| "$cache.tmp" 2>/dev/null && [[ -s "$cache.tmp" ]]; then
      mv "$cache.tmp" "$cache"
    else
      rm -f "$cache.tmp"
    fi
  fi
  [[ -f "$cache" ]] && source "$cache"
}

# ---- mise (sync: tools must be on PATH before completions/prompt) ----
_eval_cached mise mise activate zsh

# ---- zinit ----
ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
[[ -f "$ZINIT_HOME/zinit.zsh" ]] && source "$ZINIT_HOME/zinit.zsh"

# ---- deferred compinit plumbing ----
# compinit runs in the turbo block (after the first prompt), so `compdef` does not
# exist at rc-load — completions registered then (e.g. `op completion`) would error.
# Queue those calls; the turbo block flushes them once compinit restores the real
# `compdef` (which overrides this stub).
typeset -ga _DEFERRED_COMPDEFS
compdef() { _DEFERRED_COMPDEFS+=("${(j: :)@}") }
_flush_deferred_compdefs() {
  (( $#_DEFERRED_COMPDEFS )) || return
  local c
  for c in "${_DEFERRED_COMPDEFS[@]}"; do compdef ${=c}; done
  _DEFERRED_COMPDEFS=()
}

# ---- starship (sync: prompt paints immediately) ----
_eval_cached starship starship init zsh

# ---- deferred tool inits (invoked from the turbo block in plugins.zsh) ----
# Rule 1 in docs/shell-performance.md: only mise (tools on PATH) and starship
# (prompt must paint) earn a sync slot. fzf's keybindings, zoxide's `z`, and op's
# completion are all unreachable until there is a prompt to type at, so they load
# ~1ms after it appears rather than ~8ms before it.
_deferred_tool_inits() {
  _eval_cached fzf fzf --zsh
  _eval_cached zoxide zoxide init zsh
  # `op completion zsh` emits `compdef _op op`. Running here rather than at rc
  # time means compinit has already restored the real compdef, so it lands
  # directly instead of going through the _DEFERRED_COMPDEFS queue.
  _eval_cached op op completion zsh
  [[ -f "$HOME/.config/op/plugins.sh" ]] && source "$HOME/.config/op/plugins.sh"
}

# ---- turbo plugins + aliases ----
[[ -f "$HOME/.config/zsh/plugins.zsh" ]] && source "$HOME/.config/zsh/plugins.zsh"
[[ -f "$HOME/.config/zsh/aliases.zsh" ]] && source "$HOME/.config/zsh/aliases.zsh"

# ---- history prefix-search on Up/Down (OMZ-style) ----
# Type a prefix, then Up/Down cycles only through history entries starting with it.
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search; bindkey '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search; bindkey '^[OB' down-line-or-beginning-search
[[ -n "${terminfo[kcuu1]}" ]] && bindkey "${terminfo[kcuu1]}" up-line-or-beginning-search
[[ -n "${terminfo[kcud1]}" ]] && bindkey "${terminfo[kcud1]}" down-line-or-beginning-search

# ---- vendor integrations (guarded; no-op when tool absent) ----
# op's completion + shell plugins load from _deferred_tool_inits above; these are
# plain PATH/fpath edits with no subprocess, so they stay sync.
[[ -d "$HOME/.grok/bin" ]] && { export PATH="$HOME/.grok/bin:$PATH"; fpath=("$HOME/.grok/completions/zsh" $fpath); }
[[ -d "$HOME/.composio" ]] && export PATH="$HOME/.composio:$PATH"

# ---- chezmoi drift nudge ----
# Shows once when the live machine has drifted from the dotfiles source, then
# clears. The actual check runs in a detached background job at most once a
# day; the sync path here is fork-free (stamp read + zsh builtins only).
() {
  local dc="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/chezmoi-drift"
  if [[ -s "$dc.out" ]]; then
    local out=$(<"$dc.out")
    print -P "%F{yellow}chezmoi drift:%f ${out//$'\n'/, } — review with 'chezmoi diff'"
    : >| "$dc.out"
  fi
  zmodload zsh/datetime
  local today; strftime -s today '%Y%m%d' "$EPOCHSECONDS"
  if [[ "$(<"$dc.stamp")" != "$today" ]] 2>/dev/null; then
    print "$today" >| "$dc.stamp" 2>/dev/null
    command -v chezmoi &>/dev/null && ( chezmoi status 2>/dev/null >| "$dc.out.tmp" && mv "$dc.out.tmp" "$dc.out" ) &>/dev/null &!
  fi
}

# ---- machine-local escape hatch (chezmoi-ignored) ----
# if-form, not `[[ ]] &&`: a missing local.zsh must not leave the shell with $?=1
if [[ -f "$HOME/.config/zsh/local.zsh" ]]; then source "$HOME/.config/zsh/local.zsh"; fi
