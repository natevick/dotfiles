[user]
	name = {{ .name }}
	email = {{ .email }}
[push]
	default = simple
[core]
	excludesfile = ~/.gitignore_global
	editor = vim
[init]
	defaultBranch = main
{{- /* Absolute path on macOS: Homebrew runs git with a stripped PATH (system
     dirs only), so a bare `gh` is "command not found" during `brew update` and
     private taps fail to fetch. */ -}}
{{- $gh := "gh" }}
{{- if eq .chezmoi.os "darwin" }}
{{-   $gh = ternary "/opt/homebrew/bin/gh" "/usr/local/bin/gh" (eq .chezmoi.arch "arm64") }}
{{- end }}
[credential "https://github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
{{- if .agent }}
# ── Agent hosts only: per-org fine-grained GitHub PATs ──────────────────────
# An agent account holds one fine-grained PAT per GitHub org under
# ~/.config/github-pats/<owner>; the helper picks one by lowercasing the owner
# from the remote URL. Scope is enforced server-side by GitHub, so these tokens
# are narrow enough to be ambient — no approval round-trip for a routine fetch.
#
# `helper =` resets the list accumulated above FIRST: for multi-valued keys git
# APPENDS rather than replaces, so without the reset the `!gh auth
# git-credential` helper would still be consulted ahead of this one. (On an
# agent host gh is not logged in, so it only ever returned nothing.)
#
# useHttpPath is load-bearing — without it git omits `path=` from the credential
# request and the helper has no owner to key a token on.
#
# Guarded on .agent because on a machine without the helper installed this would
# break github.com authentication outright.
[credential "https://github.com"]
	helper =
	helper = {{ .chezmoi.homeDir }}/.local/bin/git-credential-github-org
	useHttpPath = true
{{- end }}
[alias]
	fixup = "!fn() { _FIXUP_COMMIT=`git log -n 50 --pretty=format:'%h %s' --no-merges | fzf | cut -c -7` && git commit -m \"fixup! ${_FIXUP_COMMIT}\" && GIT_EDITOR=true git rebase --autosquash -i ${_FIXUP_COMMIT}^; }; fn"
[include]
	path = ~/.gitconfig.local
