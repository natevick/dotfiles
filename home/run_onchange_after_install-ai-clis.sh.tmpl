#!/bin/sh
# AI coding CLIs via their official native installers — all self-update in
# place, so this only bootstraps (run_onchange re-fires when a tool is added
# here, and the per-binary guards skip anything already installed). Skipped in
# containers, which preinstall what they need.
# grok lives in ~/.grok/bin (PATH + fpath wired in dot_zshrc.tmpl); claude and
# codex install straight into ~/.local/bin. The grok and codex installers are
# run with SHELL=/bin/sh so any PATH block they write lands in the unmanaged
# ~/.profile instead of the managed zshrc (codex writes one whenever it spots a
# conflicting install, even with ~/.local/bin already on PATH).
set -eu
{{- if not .container }}
export PATH="$HOME/.local/bin:$PATH"

# These downloads go through GitHub's release API, which rate-limits shared IPs — CI runners
# get a 403. A missing optional CLI should not abort the whole apply, so warn and carry on.
#
# Fetched to a file first ON PURPOSE. `curl … | sh || warn` cannot work: $? is the
# interpreter's, and sh reading an empty body exits 0, so the guard never fires and a failed
# download reads as a successful install. Verified 2026-08-28: a 403 through that pipe gives 0.
try_install() { # try_install <name> <url> <interpreter> [args...]
  _name=$1 _url=$2
  shift 2
  _tmp=$(mktemp) || { echo "!!! $_name: mktemp failed — skipping" >&2; return 0; }
  if curl -fsSL "$_url" -o "$_tmp"; then
    "$@" "$_tmp" || echo "!!! $_name install script failed — skipping" >&2
  else
    echo "!!! $_name download failed (network or rate limit) — skipping" >&2
  fi
  rm -f "$_tmp"
}

if [ ! -x "$HOME/.local/bin/claude" ]; then
  echo "==> Installing Claude Code"
  try_install "Claude Code" https://claude.ai/install.sh bash
fi

if [ ! -x "$HOME/.local/bin/codex" ]; then
  echo "==> Installing Codex CLI"
  try_install "Codex CLI" https://chatgpt.com/codex/install.sh \
    env CODEX_NON_INTERACTIVE=1 SHELL=/bin/sh sh
fi

if [ ! -x "$HOME/.grok/bin/grok" ]; then
  echo "==> Installing Grok CLI"
  try_install "Grok CLI" https://x.ai/cli/install.sh env SHELL=/bin/sh bash
fi
{{- end }}
