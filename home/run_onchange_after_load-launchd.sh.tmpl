{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# (Re)loads launchd agents when their plists change.
# plist hash: {{ include "Library/LaunchAgents/com.natevick.claude-memory-backup.plist" | sha256sum }} {{ include "Library/LaunchAgents/com.natevick.repo-sync.plist" | sha256sum }}
set -eu
UID_N=$(id -u)
for label in com.natevick.claude-memory-backup com.natevick.repo-sync; do
  launchctl bootout "gui/$UID_N/$label" 2>/dev/null || true
  launchctl bootstrap "gui/$UID_N" "$HOME/Library/LaunchAgents/$label.plist"
  echo "==> launchd agent loaded: $label"
done
{{ end -}}
